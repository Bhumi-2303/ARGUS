# ==================================================================
# ARGUS Environment Configuration Example
# ==================================================================

# Deployment Mode: "demo" (seeded replay harness) or "production" (live OT feed integration)
ARGUS_MODE=demo

# API Bind Host and Port
ARGUS_HOST=0.0.0.0
ARGUS_PORT=8000

# Locked CORS Origins (Comma-Separated)
ARGUS_ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:8000,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional Path Overrides (Defaults baked into container at /app)
ARGUS_ARTIFACT_DIR=artifacts/models
ARGUS_RESULTS_DIR=results/verified
ARGUS_DATA_DIR=data/samples
