# ==================================================================
# ARGUS Environment Configuration
# ==================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ==================================================================

# --- Application ---
ARGUS_ENV=development
ARGUS_DEBUG=true
ARGUS_HOST=0.0.0.0
ARGUS_PORT=8000
ARGUS_LOG_LEVEL=DEBUG
ARGUS_WORKERS=1

# --- Security ---
ARGUS_SECRET_KEY=change-this-to-a-random-secret-key-in-production
ARGUS_JWT_SECRET_KEY=change-this-to-a-different-random-secret-key
ARGUS_JWT_ALGORITHM=HS256
ARGUS_JWT_EXPIRY_MINUTES=60
ARGUS_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ARGUS_RATE_LIMIT_REQUESTS=100
ARGUS_RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
ARGUS_SQLITE_PATH=data/argus.db
ARGUS_CHROMADB_PATH=data/chromadb

# --- Google ADK ---
ARGUS_ADK_ENABLED=false
ARGUS_GOOGLE_API_KEY=
ARGUS_ADK_MODEL=gemini-2.0-flash

# --- MCP ---
ARGUS_MCP_ENABLED=false

# --- Feature Flags ---
ARGUS_FEATURE_ADK_PLANNING=false
ARGUS_FEATURE_VECTOR_MEMORY=true
ARGUS_FEATURE_AUDIT_LOGGING=true
ARGUS_FEATURE_RATE_LIMITING=true

# --- Agent Defaults ---
ARGUS_AGENT_HEARTBEAT_INTERVAL=30
ARGUS_AGENT_TASK_TIMEOUT=300
ARGUS_AGENT_MAX_RETRIES=3
