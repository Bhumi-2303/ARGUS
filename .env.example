# ==================================================================
# ARGUS Environment Configuration Reference
# ==================================================================

# Environment mode: "development" or "production"
# Set to "production" to activate strict fail-closed security gates
ENVIRONMENT=development
ARGUS_MODE=demo

# Server binding
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8000
WORKERS=1

# Cryptographic Secret Key (Used for session integrity)
# MANDATORY IN PRODUCTION: Must be at least 32 characters, non-placeholder
# Example generation: openssl rand -hex 32
SECRET_KEY=development-only-insecure-secret-key-32chars-min

# ==================================================================
# OIDC / OAuth 2.0 JWT Authentication
# ==================================================================
# In production, OIDC_ENABLED must be true with a valid HTTPS issuer and JWKS URL.
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.grid-ops.internal
OIDC_AUDIENCE=argus-api
OIDC_JWKS_URL=https://auth.grid-ops.internal/.well-known/jwks.json
OIDC_ALGORITHMS=["RS256", "ES256"]

# ==================================================================
# CORS & Ingress Security
# ==================================================================
# In production, wildcard "*" and "localhost" are forbidden.
# Comma-separated list or JSON array of authorized origins
ARGUS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:5173
CORS_ORIGINS=["http://localhost:8000", "http://localhost:5173"]

# ==================================================================
# Security Limits & Rate Limiting
# ==================================================================
MAX_REQUEST_SIZE_BYTES=1048576
MAX_CONCURRENT_INFERENCES=10
WEBSOCKET_IDLE_TIMEOUT_SECONDS=60
MAX_WEBSOCKET_DURATION_SECONDS=3600
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ==================================================================
# Artifacts & Telemetry Paths (Defaults baked into container)
# ==================================================================
ARGUS_ARTIFACT_DIR=artifacts/models
ARGUS_RESULTS_DIR=results/verified
ARGUS_DATA_DIR=data/samples
