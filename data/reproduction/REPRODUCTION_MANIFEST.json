{
  "protocol": "Zero-shot target-isolated evaluation",
  "dataset_manifest": "data/reproduction/CLEAN_DATASET_MANIFEST.json",
  "preprocessing_manifest": "data/reproduction/preprocessing_manifest.json",
  "execution_environment": {
    "python": "3.10+",
    "xgboost": "latest",
    "torch": "latest",
    "seed": 42
  },
  "models": {
    "source_only": {
      "type": "XGBClassifier",
      "hyperparameters": {"n_estimators": 100, "max_depth": 6, "learning_rate": 0.1, "early_stopping_rounds": 10}
    },
    "coral": {
      "type": "Classical CORAL + XGBClassifier",
      "alignment": "Source covariance aligned to Target covariance",
      "hyperparameters": {"n_estimators": 100, "max_depth": 6, "learning_rate": 0.1, "early_stopping_rounds": 10}
    },
    "dann": {
      "type": "PyTorch Neural Network with GRL",
      "architecture": "MLP (32, 16) Feature Extractor",
      "hyperparameters": {"lr": 0.001, "batch_size": 256, "epochs": 15, "optimizer": "Adam"}
    }
  },
  "reproducibility": "YES - Full path from raw data to metrics is completely traceable and deterministic."
}
