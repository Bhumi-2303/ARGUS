    "batch_size": 16384,
    "max_epochs": 10,
    "patience": 2,
    "max_train_samples": 500000,
    "loss_function": "BCEWithLogitsLoss(label_smoothing=0.05)",
    "scaling": "StandardScaler",
    "device": "auto"
  },
  "experiment": {
    "id": "A1",
    "description": "FT-Transformer SMALL + Label Smoothing (0.05)",
    "feature_set": "ARGUS-4",
    "features": ["pkt_mean_to_max", "tcp_flag_density", "log_pkt_mean", "log_pkt_max"],
    "source_domain": "D1 (CICIoT2023)",
